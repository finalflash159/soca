# Runtime artifacts
runs/
logs/
artifacts/local/
runtime/qwen-asr/.runtime-receipt.json
*.log
*.wav
*.mp3

# Vendored external source: keep source trackable, ignore generated/heavy artifacts
external/**/.git/
external/**/.gradle/
external/**/*.mp4
!external/valtec-tts/src/models/
!external/valtec-tts/src/models/**

# Local agent/project memory
.brv/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets — never commit API keys
.env
.env.*
!.env.example
~/.config/soca/keys.json

# Streamlit
.streamlit/secrets.toml

zplan/
claude_web/

# Keep the TTS model root available for checksum-pinned Valtec artifacts.
!models/
models/*
!models/tts/
models/tts/*
ui/node_modules/
ui/dist/
