{
  "schema_version": 1,
  "name": "voice_knowledge_p0",
  "status": "diagnostic_baseline_only",
  "seed": 20260729,
  "split_policy": "semantic_family_grouped",
  "datasets": {
    "turn_routing": "eval/prompts/p0/turn_routing_vi.jsonl",
    "source_selection": "eval/prompts/p0/retrieval_source_vi.jsonl",
    "grounding": "eval/prompts/p0/grounding_vi.jsonl",
    "memory_policy": "eval/prompts/p0/memory_context_policy_vi.jsonl",
    "voice_parity": "eval/prompts/p0/voice_parity_vi.jsonl",
    "route_examples": "eval/prompts/p0/turn_routing_examples_vi.jsonl",
    "grounding_corpus": "eval/fixtures/real_rag_vault"
  },
  "metrics": {
    "disposition_accuracy": {
      "formula": "exact disposition matches / scored rows",
      "minimum_test_samples": 18,
      "release_threshold": null,
      "confidence_interval": "wilson_95"
    },
    "source_exact_accuracy": {
      "formula": "exact selected source-set matches / scored rows",
      "minimum_test_samples": 12,
      "release_threshold": null,
      "confidence_interval": "wilson_95"
    },
    "unsupported_to_real_tool": {
      "formula": "out_of_scope rows routed to an executable tool / out_of_scope rows",
      "minimum_test_samples": 6,
      "release_threshold": 0.0,
      "confidence_interval": "wilson_95_upper_bound"
    },
    "voice_parity_mismatch_rate": {
      "formula": "paired groups with different disposition/source/tool / paired groups",
      "minimum_test_samples": 4,
      "release_threshold": null,
      "confidence_interval": "wilson_95"
    },
    "answerable_retrieval_recall_at_5": {
      "formula": "answerable rows with a relevant path in top five / answerable rows",
      "minimum_test_samples": 6,
      "release_threshold": null,
      "confidence_interval": "wilson_95"
    },
    "unanswerable_false_evidence_rate": {
      "formula": "unanswerable rows with accepted evidence / unanswerable rows",
      "minimum_test_samples": 6,
      "release_threshold": null,
      "confidence_interval": "wilson_95_upper_bound"
    },
    "memory_injected_precision": {
      "formula": "relevant injected archive cases / injected archive cases",
      "minimum_test_samples": 6,
      "release_threshold": null,
      "confidence_interval": "not_applicable_model_free_policy_harness"
    },
    "archive_search_rate": {
      "formula": "archive retrieval calls / policy rows, reported with explicit archive denominator",
      "minimum_test_samples": 8,
      "release_threshold": null,
      "confidence_interval": "not_applicable_model_free_policy_harness"
    },
    "memory_prompt_token_cost": {
      "formula": "approximate UTF-8/4 token count of memory context prompt",
      "minimum_test_samples": 16,
      "release_threshold": null,
      "confidence_interval": "p50_p95_descriptive"
    }
  },
  "commands": {
    "schema": "uv run pytest -q tests/test_voice_knowledge_p0_data.py",
    "route_baseline": "uv run python -m eval.eval_full_cascade --dataset eval/prompts/p0/turn_routing_vi.jsonl --examples eval/prompts/p0/turn_routing_examples_vi.jsonl --run-local --predictions eval/results/voice_knowledge_p0/route_predictions.jsonl --output eval/results/voice_knowledge_p0/route.json",
    "source_baseline": "uv run python -m eval.eval_source_policy --dataset eval/prompts/p0/retrieval_source_vi.jsonl --examples eval/prompts/p0/turn_routing_examples_vi.jsonl --run-local --predictions eval/results/voice_knowledge_p0/source_predictions.jsonl --output eval/results/voice_knowledge_p0/source.json",
    "grounding_baseline": "uv run python -m eval.eval_grounding --vault eval/fixtures/real_rag_vault --dataset eval/prompts/p0/grounding_vi.jsonl --variant cached_sparse --output eval/results/voice_knowledge_p0/grounding.json",
    "memory_policy_baseline": "uv run python -m eval.eval_memory_context_policy --dataset eval/prompts/p0/memory_context_policy_vi.jsonl --output eval/results/voice_knowledge_p0/memory.json",
    "route_bakeoff": "uv run python -m eval.eval_router_bakeoff --dataset eval/prompts/p0/turn_routing_vi.jsonl --examples eval/prompts/p0/turn_routing_examples_vi.jsonl --output eval/results/voice_knowledge_p0/bakeoff.json"
  },
  "decision_rule": "P0 freezes schema/splits and records a baseline; it does not select production thresholds or enable voice semantic routing by itself."
}
